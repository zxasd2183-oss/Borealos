# CodeWork 2.0 环境变量配置示例
# 复制此文件为 .env 或 .env.local 并填写实际值
# 优先级：.env.local > .env.{env} > .env > 系统环境变量

# ── 基础 ──
# NODE_ENV=development

# ── 日志 ──
# CODEWORK_LOG_LEVEL=info

# ── 工具 ──
# CODEWORK_TOOL_TIMEOUT=30000

# ── 执行器 ──
# CODEWORK_MAX_RETRIES=2
# CODEWORK_RETRY_DELAY_MS=1000

# ── 数据库（SQLite 迁移预留）──
# CODEWORK_DB_TYPE=json
# CODEWORK_DB_PATH=./.codework/codework.db

# ── 服务器（HTTPS 预留）──
# CODEWORK_SERVER_ENABLED=false
# CODEWORK_SERVER_HOST=127.0.0.1
# CODEWORK_SERVER_PORT=3000
# CODEWORK_SERVER_HTTPS=false
# CODEWORK_SERVER_CERT_PATH=
# CODEWORK_SERVER_KEY_PATH=
# CODEWORK_SERVER_REDIRECT_HTTP=true

# ── 备份模块（定时备份到阿里云 VPS）──
# BACKUP_ENABLED=true
# BACKUP_VPS_HOST=your-vps-host
# BACKUP_VPS_USER=root
# BACKUP_VPS_KEY_PATH=C:\Users\YourName\.ssh\id_rsa
# BACKUP_VPS_PASSWORD=
# BACKUP_VPS_PORT=22
# BACKUP_REMOTE_PATH=/data/backups/codework2
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=7
# BACKUP_RETENTION_REMOTE_DAYS=30
