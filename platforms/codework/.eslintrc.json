{
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "commonjs"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "prefer-const": "warn",
    "eqeqeq": ["error", "always"],
    "semi": ["warn", "always"],
    "quotes": ["warn", "single"],
    "indent": ["warn", 4],
    "no-trailing-spaces": "warn",
    "eol-last": ["warn", "always"]
  }
}
