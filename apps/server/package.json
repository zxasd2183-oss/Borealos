{
  "name": "@borealos/server",
  "version": "0.1.0",
  "private": true,
  "description": "BorealOS 后端服务器 - 基于 Fastify 的 IDE 后端",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
