{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora",
  "version": "0.2.0",
  "identifier": "dev.aurora.app",
  "build": {
    "beforeDevCommand": "cd ../web && npx vite --port 5173 --host",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../web && pnpm vite build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "login",
        "title": "Aurora — 登录",
        "width": 420,
        "height": 600,
        "minWidth": 420,
        "minHeight": 600,
        "maxWidth": 420,
        "maxHeight": 600,
        "decorations": false,
        "transparent": false,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "alwaysOnTop": true
      },
      {
        "label": "main",
        "title": "Aurora — 极光智能",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "Aurora",
    "category": "Productivity",
    "shortDescription": "Aurora AI 智能工作站",
    "longDescription": "Aurora — 极光智能 AI 工作站，集成对话、Work 模式、图片生成、自由画布等功能"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "http://127.0.0.1:3005/api/update/check/{{target}}/{{arch}}/{{current_version}}",
        "http://8.148.237.155:3005/api/update/check/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    },
    "global-shortcut": {
      "active": true
    }
  }
}
