<?xml version="1.0" encoding="utf-8" standalone="no"?>
<installer-gui-script minSpecVersion="2">
    <!-- 标题栏 -->
    <title>Aurora 安装器</title>
    
    <!-- 组织 -->
    <organization>Aurora</organization>
    
    <!-- 安装到默认位置（/Applications） -->
    <options customize="never" require-scripts="false" rootVolumeOnly="true" />
    
    <!-- 自定义背景图 -->
    <background file="resources/background.png" alignment="center" scaling="proportional" />
    
    <!-- 欢迎页（RTFD 富文本） -->
    <welcome file="resources/welcome.rtf" />
    
    <!-- 自述文件 -->
    <readme file="resources/readme.rtf" />
    
    <!-- 许可协议 -->
    <license file="resources/license.rtf" />
    
    <!-- 结论页 -->
    <conclusion file="resources/conclusion.rtf" />
    
    <!-- 安装选项：Aurora.app -->
    <choices-outline>
        <line choice="choice_aurora" />
    </choices-outline>
    
    <choice id="choice_aurora" title="Aurora" tooltip="Aurora AI Desktop">
        <pkg-ref id="dev.aurora.app" />
    </choice>
    
    <pkg-ref id="dev.aurora.app" version="0.4.0" onConclusion="none">
        Aurora.pkg
    </pkg-ref>
    
    <!-- 安装后脚本 -->
    <scripts>
        <postinstall file="resources/postinstall.sh" />
    </scripts>
</installer-gui-script>
