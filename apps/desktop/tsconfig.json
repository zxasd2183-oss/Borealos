{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.desktop.tsbuildinfo"
  },
  "include": ["src"]
}
