{
  "name": "borealos-win",
  "version": "5.1.8",
  "description": "Borealos Windows 客户端（托盘 + 悬浮灵动胶囊）",
  "main": "main.js",
  "private": true,
  "author": "Borealos",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.borealos.app",
    "productName": "Borealos",
    "asar": true,
    "files": [
      "main.js",
      "feedback-preload.js",
      "trusted-origin.js",
      "popup.html",
      "popup-preload.js",
      "tray-icon*.png",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Borealos-${version}-Windows-Setup.${ext}"
    }
  }
}
