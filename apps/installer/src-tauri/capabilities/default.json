{
  "$schema": "https://schemas.tauri.app/desktop/2",
  "identifier": "default",
  "description": "Aurora 安装器默认权限：允许事件收发、对话框打开、Shell 执行（用于快捷方式创建）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:default",
    "dialog:allow-open",
    "shell:allow-execute",
    "shell:allow-open",
    "shell:allow-spawn",
    "shell:allow-kill"
  ]
}
