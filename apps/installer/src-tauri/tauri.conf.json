{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuroraSetup",
  "version": "0.4.0",
  "identifier": "dev.aurora.installer",
  "build": {
    "beforeDevCommand": "npx vite --port 1421 --host",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "cd ../ && npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurora Setup",
        "width": 640,
        "height": 440,
        "minWidth": 640,
        "minHeight": 440,
        "maxWidth": 640,
        "maxHeight": 440,
        "decorations": false,
        "transparent": false,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "pkg"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "publisher": "Aurora",
    "category": "Utility",
    "shortDescription": "Aurora Setup",
    "longDescription": "Aurora 自定义动画安装器，提供品牌化的安装体验。",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
