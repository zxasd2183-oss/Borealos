# BorealOS AI 网关环境变量配置

# 网关监听端口
GATEWAY_PORT=8787

# 上游 AI 服务 API 地址（阿里云百炼 Token Plan）
UPSTREAM_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 阿里云百炼 API Key
DASHSCOPE_API_KEY=your-api-key-here

# 连接池大小（每个上游主机的最大空闲连接数）
MAX_CONNECTIONS=100

# 请求超时时间（秒）
TIMEOUT_SECS=120

# 日志级别（RUST_LOG 环境变量）
# 例: info,borealos_gateway=debug
RUST_LOG=info
