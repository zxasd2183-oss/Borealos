<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全屏无 ActionBar 主题（继承平台 NoActionBar，避免引入 appcompat 依赖） -->
    <style name="Theme.Nexa" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#6D5DF6</item>
        <item name="android:navigationBarColor">#0B0B12</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
