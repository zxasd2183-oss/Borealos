{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* 模块解析 */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* 严格类型检查 */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* 路径别名 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@borealos/shared": ["../../packages/shared/src/index.ts"],
      "@borealos/shared/*": ["../../packages/shared/src/*"],
      "@borealos/editor": ["../../packages/editor/src/index.ts"],
      "@borealos/editor/*": ["../../packages/editor/src/*"],
      "@borealos/api": ["../../packages/api/src/index.ts"],
      "@borealos/api/*": ["../../packages/api/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
