# pnpm 配置
# 使用 hoisted 链接模式（兼容未声明 peer 依赖的包）
node-linker=hoisted

# 将依赖提升到 node_modules 根目录（兼容 npm 风格的包查找）
shamefully-hoist=true

# 不强制 peer 依赖版本匹配（避免常见的 peer 依赖冲突）
strict-peer-dependencies=false

# 预批准 esbuild 构建脚本（pnpm v10+ 默认不执行依赖的构建脚本）
# 避免 ERR_PNPM_IGNORED_BUILDS 错误
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=@swc/core
