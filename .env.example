# ============================================================
# BorealOS 环境变量配置
# ============================================================
# 复制为 .env 并修改：
#   cp .env.example .env
# ============================================================

# ---- 基础配置 ----
NODE_ENV=production
PORT=3001

# ---- 数据库 ----
# memory = 内存模式（开发用），postgres = PostgreSQL（生产用）
DATABASE_TYPE=memory

# PostgreSQL 配置（DATABASE_TYPE=postgres 时需要）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=borealos
DB_USER=borealos
DB_PASSWORD=

# ---- Redis 缓存 ----
REDIS_URL=redis://localhost:6379

# ---- JWT 认证 ----
# 生产环境务必修改为随机字符串
JWT_SECRET=borealos-default-jwt-secret-change-me

# ---- AI 网关 ----
AI_GATEWAY_URL=http://localhost:8787
AI_API_BASE_URL=
AI_API_KEY=

# ---- 前端 ----
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# ---- Rust 网关 ----
RUST_LOG=info
GATEWAY_PORT=8787

# ---- Cloudflare（可选，用于 Tunnel/Pages 管理）----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=063867422e9fb60f62a5e7e783bbbb81
CLOUDFLARE_ZONE_ID=1477f2622ce76a9b338ee10e78f2293b
